{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.git",
      "!**/node_modules",
      "!**/coverage",
      "!**/docs/archive",
      "!**/docs/superpowers"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": {
        "preset": "recommended",
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "suspicious": {
        "preset": "recommended",
        "noDoubleEquals": "error",
        "noExplicitAny": "off"
      },
      "style": {
        "preset": "recommended",
        "noNonNullAssertion": "off",
        "useTemplate": "off"
      },
      "complexity": {
        "preset": "recommended",
        "useOptionalChain": "off",
        "useLiteralKeys": "off"
      }
    }
  }
}
